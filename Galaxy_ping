WebCtl.Handler = function(cmd)
    local action = tostring(cmd.action or "")

    if action == "refresh" then
        BuildBrainrotList(searchBox.Text or "")
        UpdateSlots()
        statusLbl.Text = "🔄 Refreshed (web)"
        return true, "refreshed"
    end

