WebCtl.Handler = function(cmd)
    local action = tostring(cmd.action or "")

    if action == "refresh" then
        BuildBrainrotList(searchBox.Text or "")
        UpdateSlots()
        statusLbl.Text = "🔄 Refreshed (web)"
        return true, "refreshed"
    end

    if action == "clean" then
        local removed = RemoveBrainrotsFromPlot()
        UpdateSlots()
        statusLbl.Text = "🗑️ Removed " .. removed .. " (web)"
        return true, "removed " .. removed
    end

    if action == "revert" then
        local duel = FindDuelGUI()
        if not duel then return false, "duel gui not open" end
        local mainData = GetViewportData(duel.main)
        local otherData = GetViewportData(duel.other)
        if mainData and mainData.viewport then
            ClearViewport(mainData.viewport)
            if mainData.title then mainData.title.Text = "Noobini Pizzanini" end
            if mainData.cash then mainData.cash.Text = "$1/s" end
        end
        if otherData and otherData.viewport then
            ClearViewport(otherData.viewport)
            if otherData.title then otherData.title.Text = "Svinina Bombardino" end
            if otherData.cash then otherData.cash.Text = "$10/s" end
        end
        UpdateSlots()
        statusLbl.Text = "↩️ Reverted (web)"
        return true, "reverted"
    end

    if action == "spoof" then
        local slot = (tostring(cmd.slot or "Main") == "Other") and "Other" or "Main"
        local name = tostring(cmd.brainrot or "")
        if name == "" then return false, "no brainrot given" end
        local duel = FindDuelGUI()
        if not duel then return false, "duel gui not open" end
        local section = (slot == "Main") and duel.main or duel.other
        if not section then return false, "slot not found" end
        local success, removed = SwapBrainrot(section, name, slot)
        if success then
            UpdateSlots()
            statusLbl.Text = "✅ " .. name .. " (web)"
            return true, "spoofed " .. name .. " / removed " .. tostring(removed)
        end
        return false, "swap failed"
    end

    return false, "unknown action"
end

