function WebCtl.Post(path, payload)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
        or (fluxus and fluxus.request) or (krnl and krnl.request)
    if not req then return nil, "no http" end
    local ok, res = pcall(req, {
        Url = WebCtl.Base .. path,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = WebCtl.HS:JSONEncode(payload),
    })
    if not ok then return nil, tostring(res) end
    if type(res) ~= "table" or not res.Body then return nil, "no body" end
    local ok2, data = pcall(function() return WebCtl.HS:JSONDecode(res.Body) end)
    if not ok2 then return nil, tostring(res.Body):sub(1, 120) end
    return data
end

